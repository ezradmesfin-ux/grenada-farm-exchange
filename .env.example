# Copy to .env (or set these in your hosting dashboard). Never commit real values.

# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
BASE_URL=https://exchange.example.gd        # the public address, no trailing slash
NODE_ENV=production
PORT=3000

# Shown on the Terms and Privacy pages and in messages
OPERATOR_NAME=Ministry of Agriculture       # who runs the site
CONTACT_EMAIL=exchange@example.gd

# The first administrator. Used only while no administrator exists yet.
# After the first start, delete ADMIN_INITIAL_PASSWORD from your settings.
ADMIN_EMAIL=you@example.gd
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Your Name

# Optional: lets an outside timer trigger matching (POST /internal/run-matching with
# the header "Authorization: Bearer <this value>"). Matching also runs by itself.
CRON_SECRET=

# Text messages and WhatsApp (Twilio). Leave empty to only log messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+14155550100                # a Twilio number or approved sender
TWILIO_WHATSAPP_FROM=+14155550101           # a WhatsApp-enabled Twilio sender

# Email (Resend). Leave empty to only log messages.
RESEND_API_KEY=
MAIL_FROM=Grenada Farm Exchange <notify@exchange.example.gd>
